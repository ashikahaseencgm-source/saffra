# ================================================================
# Saffra — .gitignore for Vercel Deployment
# Ensures only source code & assets required for Vercel are pushed
# ================================================================

# --- Node & Dependencies ---
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Vercel local cache ---
.vercel/

# --- Environment & Secrets ---
.env
.env.*
!.env.example
secrets.json

# --- OS & IDE artifacts ---
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# --- Build outputs & compiler caches ---
dist/
build/
coverage/
.cache/
.turbo/
.vite/
*.tsbuildinfo
apps/api/dist/
apps/web/dist/
apps/website/dist/
packages/*/dist/
apps/api/generated/

# --- SQLite temporary files & local runtime caches ---
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
# Ignore other sqlite databases except the seeded demo database
*.db
!apps/api/prisma/dev.db

# --- Excluded non-Vercel applications & media ---
# Windows Electron packaging & installer
apps/desktop/
# Standalone React Native / Expo mobile app
mobile/
# Video generation tools, Remotion renders, raw demo clips
scripts/
# Internal dev guides, CI desktop release workflow, and raw design docs
.claude/
.github/
docs/
assets/
CLAUDE.md
