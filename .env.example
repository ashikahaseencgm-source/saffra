# ────────────────────────────────────────────────────────────────
# Saffra — environment configuration
# Copy this file to .env (root) and fill in real values.
# .env is gitignored — never commit real secrets.
# ────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Saffra is local-first: a single embedded SQLite file, no cloud database and
# no separate DB server to install. In the packaged desktop app this path is
# set automatically to a file inside the OS's per-user app-data folder (see
# apps/desktop/src/main.ts); for local `npm run dev` it defaults to a file
# alongside the schema.
DATABASE_URL="file:./dev.db"

# ── Auth ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
# Encrypts secrets Saffra stores in its database (e.g. the restaurant's
# Razorpay key secret). Optional — derived from JWT_REFRESH_SECRET if unset.
# The desktop app generates a random one per install.
DATA_ENCRYPTION_KEY=
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── Server ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Saffra binds to 0.0.0.0 and serves both the API and the built frontend from
# this single port, so every device on the restaurant's Wi-Fi reaches it at
# http://<this-computer's-LAN-IP>:<PORT>. The frontend always calls the API
# and socket on relative/same-origin paths (no VITE_API_BASE_URL to set) —
# in dev, apps/web/vite.config.ts proxies those to this API dev server so
# the same relative-path code works whether it's :5173 talking to :4000
# locally, or a single packaged/LAN origin in production. CORS_ORIGIN below
# only matters for that dev-time cross-origin case.
CORS_ORIGIN="http://localhost:5173"
# Friendly Wi-Fi access: Saffra announces http://<restaurant-name>.local on
# the network (mDNS) and, in production, also listens on port 80 so staff
# don't need to type ":4000". FRIENDLY_PORT=0 turns the extra port off.
# FRIENDLY_PORT=80
# LOCAL_NAME_ENABLED=true

# ── Razorpay ──────────────────────────────────────────────────
# Normally the restaurant enters its own keys in Settings → Online Payments
# (stored encrypted in the database). These env vars are only a fallback
# for development; saved Settings keys take priority. Blank = Demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
