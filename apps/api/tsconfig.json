{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "outDir": "dist",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@saffra/types": ["../../packages/types/src/index.ts"],
      "@saffra/config": ["../../packages/config/src/index.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "api", "prisma/seed.ts", "scripts"],
  "exclude": ["node_modules", "dist", "generated"]
}
